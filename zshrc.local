# Add cursor (launcher) to the path
export PATH="/Applications/Cursor.app/Contents/Resources/app/bin:$PATH"

# Set up GPG for git commit signing
export GPG_TTY=$(tty)

# ~~~ gh ~~~

# Search for a pattern with `rg`, interactively look through results with `fzf`,
# and then open in github with `gh browse`
rgbr() {
  local rg_cmd="rg --line-number --no-heading --color=always --smart-case"
  local selection
  selection=$(
    : | fzf --ansi \
            --disabled \
            --query "${1:-}" \
            --bind "start:reload:$rg_cmd {q} || true" \
            --bind "change:reload:sleep 0.1; $rg_cmd {q} || true" \
            --delimiter=: \
            --preview '
              bat --style=numbers --color=always --highlight-line {2} {1} \
                | rg --color=always --smart-case --passthru --context 1000 {q}
            ' \
            --preview-window='right:60%:+{2}/2' \
            --bind 'ctrl-/:change-preview-window(down|hidden|)'
  ) || return 1

  local file line
  file=$(echo "$selection" | awk -F: '{print $1}')
  line=$(echo "$selection" | awk -F: '{print $2}')
  gh browse "${file}:${line}"
}

# ~~~ Git ~~~

# Copied from https://github.com/junegunn/fzf/wiki/Examples#git
fbr() {
  local branches branch
  branches=$(git for-each-ref --count=30 --sort=-committerdate refs/heads/ --format="%(refname:short)") &&
    branch=$(echo "$branches" |
      fzf-tmux -d $((2 + $(wc -l <<<"$branches"))) +m) &&
    git checkout $(echo "$branch" | sed "s/.* //" | sed "s#remotes/[^/]*/##")
}

# fco_preview - checkout git branch/tag, with a preview showing the commits between the tag/branch and HEAD
fco_preview() {
  local tags branches target
  branches=$(
    git --no-pager branch --all \
      --format="%(if)%(HEAD)%(then)%(else)%(if:equals=HEAD)%(refname:strip=3)%(then)%(else)%1B[0;34;1mbranch%09%1B[m%(refname:short)%(end)%(end)" |
      sed '/^$/d'
  ) || return
  tags=$(
    git --no-pager tag | awk '{print "\x1b[35;1mtag\x1b[m\t" $1}'
  ) || return
  target=$(
    (
      echo "$branches"
      echo "$tags"
    ) |
      fzf --no-hscroll --no-multi -n 2 \
        --ansi --preview="git --no-pager log -150 --pretty=format:%s '..{2}'"
  ) || return
  git checkout $(awk '{print $2}' <<<"$target")
}
